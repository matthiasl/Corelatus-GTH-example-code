#!/bin/bash -eu

source testlib.sh

usage()
{
    echo "Usage: $0 <IP>"
    echo ""
    exit 1
}

valid_disable()
{
    $BUILD_DIR/enable $IP $@ 2>/dev/null
    $BUILD_DIR/disable $IP $1 2>/dev/null
}

invalid_disable()
{
    if $BUILD_DIR/disable $IP bogus 2>/dev/null
    then echo "invalid disable 1 succeeded"; exit 1; fi
}

if [ $# -lt 1 ]
then usage
fi

IP=$1
version=`$BUILD_DIR/query_set $IP system_image version | cut -d = -f 2`

case $version in
    gth2_system_36b)
	echo "skipping $0 because DUT is running a release without 'disable'" ;;
    *)
	invalid_disable
	case $(card_arch $IP) in
	    sth*)
		valid_disable sdh1;;
	    *)
		valid_disable pcm1 tx_enabled false
	esac
esac
