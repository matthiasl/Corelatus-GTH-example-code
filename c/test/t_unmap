#!/bin/bash -eu

# Exercise the unmap sample code

source testlib.sh

usage()
{
    echo "Usage: $0 <IP>"
    echo ""
    exit 1
}

unmap_valid()
{
    $BUILD_DIR/enable $IP sdh1 2>/dev/null
    local new_pcm=$($BUILD_DIR/map $IP sdh1:hop1_1:lop1_5_3)
    $BUILD_DIR/query_set $IP $new_pcm >/dev/null
    $BUILD_DIR/unmap $IP $new_pcm
    $BUILD_DIR/disable $IP sdh1 2>/dev/null
}

unmap_invalid()
{
    if $BUILD_DIR/unmap $IP bogus 2>/dev/null
    then die "invalid unmap bogus succeeded"; fi

    if $BUILD_DIR/unmap $IP pcm536 2>/dev/null
    then die "invalid unmap pcm536 succeeded"; fi
}

if [ $# -lt 1 ]
then usage
fi

IP=$1
arch=$($BUILD_DIR/query_set $IP board architecture | cut -d = -f 2)
case $arch in
sth3.0)
    unmap_valid
    unmap_invalid
    echo "Test completed successfully" ;;
*)
    echo "skipping unmap test because DUT is a $arch"
esac
